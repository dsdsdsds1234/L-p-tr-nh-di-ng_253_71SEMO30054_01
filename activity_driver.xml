<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <!-- ========================================== -->
    <!-- CỤM HEADER TÀI XẾ: HIỆN ĐẠI, GỌN GÀNG -->
    <!-- ========================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDriverHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <RelativeLayout
            android:id="@+id/layoutDriverHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <ImageView
                android:id="@+id/btnDriverProfile"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:src="@android:drawable/sym_def_app_icon"
                android:background="@drawable/bg_circle_avatar"
                android:scaleType="centerCrop"
                android:padding="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnDriverProfile"
                android:layout_toStartOf="@id/btnDriverLogout"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDriverNameHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tài xế: Đối tác Grab"
                    android:textColor="#2C3E50"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDriverEmailHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="driver@gmail.com"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDriverLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_action_red"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- ========================================== -->
    <!-- TRẠNG THÁI 1: LƯỚI Ô VUÔNG CHỨC NĂNG TÀI XẾ -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutDriverServiceGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cardDriverHeader"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRUNG TÂM TÀI XẾ"
            android:textColor="#00B14F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Hàng 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:id="@+id/btnGridAcceptTrip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E8F5E9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="#00B14F"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bắt đầu nhận cước"
                        android:textColor="#1B5E20"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:id="@+id/btnGridCheckFare"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E3F2FD"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="#0D47A1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check-in công việc"
                        android:textColor="#0D47A1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Hàng 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:id="@+id/btnGridHistory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFF3E0"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#E65100"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch sử chuyến đi"
                        android:textColor="#E65100"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:id="@+id/btnGridWallet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F3E5F5"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/btn_star_big_on"
                        app:tint="#4A148C"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thành tích &amp; Ví"
                        android:textColor="#4A148C"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================== -->
    <!-- TRẠNG THÁI 2: MAP & BOTTOM CARD THEO DÕI NỔI -->
    <!-- ========================================== -->
    <RelativeLayout
        android:id="@+id/layoutDriverMapAndScanning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cardDriverHeader"
        android:visibility="gone">

        <!-- Map tràn nền phía dưới -->
        <org.osmdroid.views.MapView
            android:id="@+id/driverMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- CỤM NÚT ĐIỀU KHIỂN LUỒNG CHUYẾN XE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/cardBottomRadar"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:elevation="4dp">

            <!-- Nút 1: Xác nhận đã đón khách -->
            <Button
                android:id="@+id/btnPickedUp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_btn_action_green"
                android:text="Đã đón khách"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Nút 2: Hoàn tất chuyến đi -->
            <Button
                android:id="@+id/btnCompleteTrip"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_action_green"
                android:text="Hoàn tất chuyến đi"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- HỘP THẺ NỔI RADAR QUÉT (Gọn gàng ở đáy màn hình) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBottomRadar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/layoutDriverRadarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Phần Trạng thái quét nhỏ gọn -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <ProgressBar
                        android:id="@+id/radarProgressBar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="#00B14F"
                        android:layout_centerVertical="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/radarProgressBar"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/txtDriverRadarAddressTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐANG QUÉT KHÁCH HÀNG..."
                            android:textColor="#00B14F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDriverRadarAddressSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tìm kiếm các chuyến xe gần bạn"
                            android:textColor="#7F8C8D"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA"
                    android:layout_marginBottom="12dp" />

                <!-- Vùng hiển thị địa chỉ thực tế (Thay đổi ID phụ để không bị trùng lặp) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="#FF3B30" />

                    <TextView
                        android:id="@+id/txtDriverRadarAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Đang cập nhật tọa độ vị trí hiện tại..."
                        android:textColor="#34495E"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- Nút Tắt nhận cước -->
                <Button
                    android:id="@+id/btnCancelDriverScanning"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_btn_action_red"
                    android:text="Tắt nhận cước (Hủy)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

</RelativeLayout>