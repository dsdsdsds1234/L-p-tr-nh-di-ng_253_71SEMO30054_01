<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Cụm Header màu xanh lá chuẩn Grab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00B14F"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nút Back và Nút Bản đồ phía trên cùng -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />

            <LinearLayout
                android:id="@+id/btnOpenMapHeader"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="#20FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️ Bản đồ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Thanh tìm kiếm "Bạn muốn đi đâu?" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#FF3B30" />

            <EditText
                android:id="@+id/edtSearchDestination"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Bạn muốn đi đâu? (Điểm đến)"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Banner Đặt Car Xe Điện -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E8F5E9"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đặt Car Xe Điện"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rẻ quá! Đặt xe ngay ➔"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Icon xe điện giả lập -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗⚡"
            android:textSize="40sp"/>
    </LinearLayout>

    <!-- Danh sách địa điểm lịch sử gợi ý cứng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Địa điểm 1 -->
        <LinearLayout
            android:id="@+id/itemLocation1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="22sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="The Cafe Apartments" android:textStyle="bold" android:textColor="#212121" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42 Nguyễn Huệ, P. Bến Nghé, Quận 1" android:textColor="#757575" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

        <!-- Địa điểm 2 -->
        <LinearLayout
            android:id="@+id/itemLocation2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="22sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crescent Mall" android:textStyle="bold" android:textColor="#212121" android:textSize="15sp"/>

                <!-- ĐÃ SỬA TỪ wrap_width THÀNH wrap_content TẠI ĐÂY -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="101 Tôn Dật Tiên, Tân Phú, Quận 7" android:textColor="#757575" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

        <!-- Địa điểm 3 -->
        <LinearLayout
            android:id="@+id/itemLocation3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="22sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chợ Bến Thành" android:textStyle="bold" android:textColor="#212121" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lê Lợi, P. Bến Thành, Quận 1" android:textColor="#757575" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>