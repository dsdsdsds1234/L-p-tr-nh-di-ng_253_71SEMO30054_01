<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. THANH HIỂN THỊ NGƯỜI DÙNG (HEADER PROFILE) -->
    <LinearLayout
        android:id="@+id/layoutHeaderProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnProfileHeader"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xin chào,"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtHeaderUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hành khách"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. KHỐI CHỌN DỊCH VỤ ĐẶT XE -->
    <LinearLayout
        android:id="@+id/layoutServiceGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn muốn đi đâu hôm nay?"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/btnGridVehicleBike"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/imgBikeIcon" android:layout_width="55dp" android:layout_height="55dp" android:scaleType="fitCenter" android:src="@drawable/bike" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xe Máy" android:textColor="#222222" android:textStyle="bold" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGridVehicleCar4"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/imgCar4Icon" android:layout_width="55dp" android:layout_height="55dp" android:scaleType="fitCenter" android:src="@drawable/car" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xe 4 Chỗ" android:textColor="#222222" android:textStyle="bold" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/btnGridVehicleCar7"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/imgCar7Icon" android:layout_width="55dp" android:layout_height="55dp" android:scaleType="fitCenter" android:src="@drawable/car" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xe 7 Chỗ" android:textColor="#222222" android:textStyle="bold" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGridVehicleBus"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:id="@+id/imgBusIcon" android:layout_width="55dp" android:layout_height="55dp" android:scaleType="fitCenter" android:src="@drawable/bus" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xe Bus" android:textColor="#222222" android:textStyle="bold" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. KHỐI BẢN ĐỒ VÀ ĐẶT XE -->
    <RelativeLayout
        android:id="@+id/layoutMapAndBooking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeaderProfile"
        android:visibility="gone">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="4dp"
            android:elevation="4dp">

            <EditText
                android:id="@+id/edtPickupLocation"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Nhập điểm đón / Vị trí hiện tại"
                android:importantForAutofill="no"
                android:paddingStart="10dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtSearchLocation"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Bạn muốn đi đâu? (Điểm đến)"
                android:importantForAutofill="no"
                android:paddingStart="10dp"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:src="@android:drawable/ic_input_add"
                app:tint="#4CAF50"
                android:contentDescription="Phóng to" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:src="@android:drawable/button_onoff_indicator_off"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="#4CAF50"
                android:contentDescription="Thu nhỏ" />
        </LinearLayout>

        <!-- KHỐI CARD THÔNG TIN TÀI XẾ MỚI BỔ SUNG -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTripInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btnConfirmBooking"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgVehicleIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/car" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDriverVehicleName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên tài xế &amp; Xe"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang tải..."
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0đ"
                    android:textColor="#00B060"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:backgroundTint="#00B060"
            android:text="ĐẶT XE NGAY"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

</RelativeLayout>